rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /careers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['schema', 'revision', 'payload', 'updated'])
        && request.resource.data.schema == 1
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 850001
        && request.resource.data.updated == request.time
        && ((!exists(/databases/$(database)/documents/careers/$(uid)) && request.resource.data.revision == 1)
            || (exists(/databases/$(database)/documents/careers/$(uid)) && request.resource.data.revision == resource.data.revision + 1));
    }
  }
}
